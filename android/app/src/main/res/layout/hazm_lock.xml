<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/hazm_curtain"
    android:clickable="true"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:focusable="false">

    <com.hazm.hazm_app.SpineView
        android:id="@+id/lock_spine"
        android:layout_width="52dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="140dp" />

    <LinearLayout
        android:id="@+id/lock_body"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="60dp"
        android:paddingTop="16dp"
        android:paddingEnd="24dp"
        android:paddingBottom="20dp">

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <com.hazm.hazm_app.LockRingView
            android:id="@+id/lock_ring"
            android:layout_width="220dp"
            android:layout_height="220dp" />

        <TextView
            android:id="@+id/lock_eyebrow"
            style="@style/HazmLock.Eyebrow" />

        <TextView
            android:id="@+id/lock_headline"
            style="@style/HazmLock.Headline" />

        <com.hazm.hazm_app.BarView
            android:id="@+id/lock_rule"
            android:layout_width="150dp"
            android:layout_height="3dp"
            android:layout_marginTop="6dp" />

        <TextView
            android:id="@+id/lock_caption"
            style="@style/HazmLock.Caption" />

        <TextView
            android:id="@+id/lock_message"
            style="@style/HazmLock.Message" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/lock_primary"
            style="@style/HazmLock.Primary" />

        <TextView
            android:id="@+id/lock_secondary"
            style="@style/HazmLock.Secondary" />
    </LinearLayout>

    <com.hazm.hazm_app.BarView
        android:id="@+id/lock_drain"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:layout_gravity="bottom" />
</FrameLayout>
